# CipherSQLStudio - Git Ignore File
# Keeping sensitive and generated files out of version control

# Dependencies
node_modules/
*/node_modules/

# Environment variables (contains database passwords!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build outputs
build/
dist/
*/build/
*/dist/

# IDE files (in case someone uses different editors)
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

