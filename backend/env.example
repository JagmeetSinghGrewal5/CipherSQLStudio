# Server Configuration
PORT=5000

# PostgreSQL Configuration (Sandbox Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sql_sandbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB Configuration (Persistence Database)
MONGODB_URI=mongodb://localhost:27017/ciphersqlstudio
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ciphersqlstudio

# LLM Configuration
LLM_PROVIDER=openai
# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
# For Gemini:
# GEMINI_API_KEY=your_gemini_api_key_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

